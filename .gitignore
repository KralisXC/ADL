# Rust 构建产物
/target
**/*.rs.bk

# 本地测试/探针目录（含大文件与临时服务）
/probe

# 下载产物与进度
*.adl
*.part

# 本地用户配置与历史（每台机器不同，不入库）
/config.toml
history.json

# 前端 node_modules（目录联接，指向外部已装依赖）与构建产物
/web/node_modules
/web/dist

# 编辑器
.vscode/
.idea/

# PowerShell 源码（只作 UI 参考，不参与构建）
/PowerShell-master
# ffmpeg 二进制（67 MB，只走 Releases 的 zip 包分发，不入库）
/plugins/com.kralisxc.media-converter/bin/
# 插件打包产物（走 adl-extensions 的 Releases）
/dist

# 运行时数据目录（默认就在 exe 同级 data/，绿色版拷走即可）
/data/
# rc.exe 的中间产物与自动更新留下的旧 exe
*.res
*.old

# 代码签名证书：.pfx 里是**私钥**，绝不能进仓库
/certs/
*.pfx
