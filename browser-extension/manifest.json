{
  "manifest_version": 3,
  "name": "ADL 下载桥",
  "version": "0.2.0",
  "description": "把浏览器下载交给 ADL。浏览器里只有一个开关，其余设置都在 ADL 桌面端的「浏览器接管」页。",
  "key": "",
  "permissions": [
    "downloads",
    "cookies",
    "storage",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ADL 下载桥",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
